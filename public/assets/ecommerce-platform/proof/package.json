{
  "name": "ecommerce-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:e2e": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "e2e": "playwright test",
    "load": "k6 run load/checkout.js",
    "assets": "node scripts/capture-screenshots.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "release": "prisma migrate deploy && prisma db seed -- --seed 42 --if-empty",
    "db:drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "verify": "eslint . && tsc --noEmit && vitest run --coverage && prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code && playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.0.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "prisma": "^6.0.0",
    "sharp": "^0.34.4",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
