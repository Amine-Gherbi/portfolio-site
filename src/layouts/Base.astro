---
import "../styles/global.css";
import { NAV_ROUTES, SITE_NAME, SITE_URL } from "../lib/site";
import resume from "../data/resume.json";

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  ogImage?: string;
  /** On the home page the wordmark is the page's single h1. */
  wordmarkAsHeading?: boolean;
}

const { title, description, jsonLd, ogImage, wordmarkAsHeading = false } =
  Astro.props;
const pageTitle = `${title} · ${SITE_NAME}`;
const metaDescription =
  description ??
  "Full-stack developer in Biskra, Algeria. Three case studies and a Master's thesis on blockchain for social security.";
const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, site).toString();
const socialImage = new URL(ogImage ?? "/og/home.png", site).toString();
const currentPath = Astro.url.pathname;

function isCurrent(path: string): boolean {
  const target = path.split("#")[0] ?? path;

  if (target === "/") {
    return currentPath === "/" || currentPath.startsWith("/projects/");
  }

  return currentPath === target || currentPath.startsWith(target);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#faf9f7" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    {
      jsonLd ? (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      ) : null
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <div class="identity">
          {
            wordmarkAsHeading ? (
              <h1 class="wordmark-heading">
                <a class="wordmark" href="/" aria-label={`${SITE_NAME}, home`}
                  >{SITE_NAME}</a
                >
              </h1>
            ) : (
              <a class="wordmark" href="/" aria-label={`${SITE_NAME}, home`}
                >{SITE_NAME}</a
              >
            )
          }
          <span class="site-role">{resume.role}</span>
        </div>
        <nav class="site-nav" aria-label="Site">
          <ul>
            {
              NAV_ROUTES.map((route) => (
                <li>
                  <a
                    href={route.path}
                    aria-current={isCurrent(route.path) ? "page" : undefined}
                  >
                    {route.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <p class="footer-note">
            Biskra, Algeria · <a href="mailto:meh.amine.gherbi@gmail.com"
              >meh.amine.gherbi@gmail.com</a
            >
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
