---
import "../styles/global.css";
import { NAV_ROUTES, SITE_NAME, SITE_URL } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  ogImage?: string;
}

const { title, description, jsonLd, ogImage } = Astro.props;
const pageTitle = `${title} · ${SITE_NAME}`;
const metaDescription =
  description ??
  "An engineering case index: three systems, each stated as a claim and shown against a committed snapshot.";
const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, site).toString();
const socialImage = new URL(ogImage ?? "/og/home.png", site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#faf9f7" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    {
      jsonLd ? (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      ) : null
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Mohamed L'Amine Gherbi, home"
          >Mohamed L'Amine Gherbi</a
        >
        <nav class="site-nav" aria-label="Site">
          <ul>
            {
              NAV_ROUTES.map((route) => (
                <li><a href={route.path}>{route.label}</a></li>
              ))
            }
          </ul>
        </nav>
        <span class="site-meta">Full-stack developer / case index</span>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <p class="footer-note">
            Case studies are reproduced from snapshots committed to this repository.
          </p>
          <p class="footer-note">Static site · no tracking</p>
        </div>
      </footer>
    </div>
  </body>
</html>
