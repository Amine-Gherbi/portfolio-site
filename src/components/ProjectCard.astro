---
import type { ManifestShot, Project, ProjectManifest } from "../lib/manifest";

interface Props {
  project: Project;
  slug: string;
  manifest: ProjectManifest | null;
  updatedLabel: string;
}

const { project, slug, manifest, updatedLabel } = Astro.props;
const hero: ManifestShot | undefined = manifest?.shots[0];
const number = String(project.order).padStart(2, "0");
const headingId = `project-${slug}`;
const imageSrc = hero ? `/assets/${slug}/${hero.file}` : "";
---

<article class="project-card" aria-labelledby={headingId}>
  {
    hero ? (
      <figure class="card-media">
        <img
          src={imageSrc}
          srcset={`${imageSrc} ${hero.width}w`}
          sizes="(min-width: 1120px) 336px, (min-width: 641px) 46vw, 100vw"
          width={hero.width}
          height={hero.height}
          alt={hero.alt}
          loading={project.order === 1 ? "eager" : "lazy"}
          decoding="async"
        />
      </figure>
    ) : (
      <div class="card-coming-soon">
        <span>Coming soon</span>
      </div>
    )
  }
  <div class="card-copy">
    <div class="card-meta">
      <span>Case {number}</span>
      <span>Updated {updatedLabel}</span>
    </div>
    <h2 id={headingId}>
      <a class="card-link" href={`/projects/${slug}/`}>{project.title}</a>
    </h2>
    <p class="one-liner">{project.oneLiner}</p>
    <p class="stack">{project.stack.join(", ")}</p>
    <p class="card-read">
      <a href={`/projects/${slug}/`}>Read the case study</a>
    </p>
  </div>
</article>
