---
import type { ManifestShot, Project, ProjectManifest } from "../lib/manifest";

interface CardImage {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  project: Project;
  slug: string;
  manifest: ProjectManifest | null;
  cover?: CardImage | null;
  actionLabel?: string;
  primaryLabel?: string;
}

const {
  project,
  slug,
  manifest,
  cover = null,
  actionLabel = "Read the case study",
  primaryLabel = "Open the live demo",
} = Astro.props;

const title = manifest?.title ?? project.title;
const oneLiner = manifest?.oneLiner ?? project.oneLiner;
const liveUrl = manifest?.live.url ?? null;

const hero: ManifestShot | undefined = manifest?.shots[0];
const image: CardImage | null =
  cover ??
  (hero
    ? {
        src: `/assets/${slug}/${hero.file}`,
        alt: hero.alt,
        width: hero.width,
        height: hero.height,
      }
    : null);
const headingId = `project-${slug}`;
const href = `/projects/${slug}/`;
---

<article class="project-card" aria-labelledby={headingId}>
  {
    image ? (
      <figure class="card-media">
        <a href={href} tabindex="-1" aria-hidden="true">
          <img
            src={image.src}
            srcset={`${image.src} ${image.width}w`}
            sizes="(min-width: 1120px) 250px, (min-width: 641px) 46vw, 100vw"
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading={project.order === 1 ? "eager" : "lazy"}
            decoding="async"
          />
        </a>
      </figure>
    ) : (
      <div class="card-coming-soon">
        <span>Coming soon</span>
      </div>
    )
  }
  <div class="card-copy">
    <h2 id={headingId}>
      <a class="card-link" href={href}>{title}</a>
    </h2>
    <p class="one-liner">{oneLiner}</p>
    <p class="card-actions">
      {
        liveUrl && (
          <a
            class="button-primary"
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {primaryLabel}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }
      <a class="card-secondary" href={href}>{actionLabel}</a>
    </p>
  </div>
</article>
