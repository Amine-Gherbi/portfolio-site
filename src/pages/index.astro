---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { readProjectManifest } from "../lib/manifest";
import { SITE_URL } from "../lib/site";

const positioningSentence =
  "I build full-stack web systems for teams that need to prove their software works.";

const coreStack = ["TypeScript", "Next.js", "PostgreSQL", "Python"];

const entries = await getCollection("projects");
entries.sort((a, b) => a.data.order - b.data.order);

const cards = await Promise.all(
  entries.map(async (entry) => {
    const manifest =
      entry.data.kind === "case-study"
        ? await readProjectManifest(entry.id)
        : null;

    return { entry, manifest };
  }),
);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mohamed L'Amine Gherbi",
  url: `${SITE_URL}/`,
  jobTitle: "Full-stack developer",
  email: "meh.amine.gherbi@gmail.com",
  description:
    "Full-stack developer in Biskra, Algeria, working with TypeScript, Next.js, PostgreSQL and Python.",
  knowsAbout: coreStack,
};
---

<Base
  title="Full-stack developer"
  description="Three case studies and a Master's thesis: an e-commerce platform, a CI/CD deployment pipeline, a document Q&A assistant, and a Hyperledger Fabric network for social security."
  jsonLd={person}
  ogImage="/og/home.png"
>
  <header class="hero">
    <h1>{positioningSentence}</h1>
    <p class="hero-stack">{coreStack.join(", ")}</p>
  </header>

  <section id="work" class="work" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading">Selected work</h2>
    </div>
    <div class="project-grid">
      {
        cards.map(({ entry, manifest }) =>
          entry.data.kind === "thesis" ? (
            <ProjectCard
              project={entry.data}
              slug={entry.id}
              manifest={manifest}
              cover={{
                src: entry.data.coverCard,
                alt: entry.data.coverAlt,
                width: 1600,
                height: 1000,
              }}
              actionLabel="Read the thesis"
            />
          ) : (
            <ProjectCard
              project={entry.data}
              slug={entry.id}
              manifest={manifest}
              cover={null}
              actionLabel="Read the case study"
            />
          ),
        )
      }
    </div>
  </section>
</Base>
