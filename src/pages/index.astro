---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { readProjectManifest } from "../lib/manifest";
import { SITE_URL } from "../lib/site";

const positioningSentence =
  "I build full-stack web systems for teams that need to prove their software works.";

const coreStack = ["TypeScript", "Next.js", "PostgreSQL", "Python"];

const entries = await getCollection("projects");
entries.sort((a, b) => a.data.order - b.data.order);

// The thesis is a publication, not a fourth card: it gets its own section.
const workEntries = entries.filter((entry) => entry.data.kind !== "thesis");

const cards = await Promise.all(
  workEntries.map(async (entry) => {
    const manifest =
      entry.data.kind === "case-study"
        ? await readProjectManifest(entry.id)
        : null;

    return { entry, manifest };
  }),
);

const thesisEntry = entries.find((entry) => entry.data.kind === "thesis");
if (!thesisEntry || thesisEntry.data.kind !== "thesis") {
  throw new Error("The thesis content entry is missing or is not kind: thesis");
}
const thesis = thesisEntry.data;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mohamed L'Amine Gherbi",
  url: `${SITE_URL}/`,
  jobTitle: "Full-stack developer",
  email: "meh.amine.gherbi@gmail.com",
  description:
    "Full-stack developer in Biskra, Algeria, working with TypeScript, Next.js, PostgreSQL and Python.",
  knowsAbout: coreStack,
};
---

<Base
  title="Full-stack developer"
  description="Three case studies and a Master's thesis: an e-commerce platform, a CI/CD deployment pipeline, a document Q&A assistant, and a Hyperledger Fabric network for social security."
  jsonLd={person}
  ogImage="/og/home.png"
>
  <header class="hero">
    <h1>{positioningSentence}</h1>
    <p class="hero-stack">{coreStack.join(", ")}</p>
  </header>

  <section id="work" class="work" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading">Selected work</h2>
    </div>
    <div class="project-grid">
      {
        cards.map(({ entry, manifest }) => (
          <ProjectCard
            project={entry.data}
            slug={entry.id}
            manifest={manifest}
            cover={null}
            actionLabel="Read the case study"
          />
        ))
      }
    </div>
  </section>

  <section id="thesis" class="thesis-section" aria-labelledby="thesis-heading">
    <div class="thesis-intro">
      <p class="kicker">Master's thesis · 2025</p>
      <h2 id="thesis-heading">
        <a href="/projects/thesis/">{thesis.thesisTitle}</a>
      </h2>
      <p class="thesis-standfirst">{thesis.oneLiner}</p>
      <dl class="thesis-facts">
        <div>
          <dt>Degree</dt>
          <dd>Master GLSD</dd>
        </div>
        <div>
          <dt>Institution</dt>
          <dd>University of Biskra</dd>
        </div>
        <div>
          <dt>Year</dt>
          <dd>2025</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>{thesis.stack.join(", ")}</dd>
        </div>
      </dl>
      <p class="thesis-actions">
        <a href="/projects/thesis/">Read the thesis</a>
        <a href="/thesis.pdf">PDF · 2.8 MB</a>
      </p>
    </div>
  </section>
</Base>
