---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { readProjectManifest } from "../lib/manifest";
import { SITE_URL } from "../lib/site";

const positioningSentence =
  "I am a full-stack developer who builds web applications with TypeScript, Next.js, PostgreSQL and Python, with a focus on backends that produce verifiable output.";

const entries = await getCollection("projects");
entries.sort((a, b) => a.data.order - b.data.order);

const cards = await Promise.all(
  entries.map(async (entry) => {
    const manifest = await readProjectManifest(entry.id);

    return { entry, manifest };
  }),
);

const updatedFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

function formatUpdated(isoDate: string): string {
  return updatedFormatter.format(new Date(`${isoDate}T00:00:00.000Z`));
}

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mohamed L'Amine Gherbi",
  url: `${SITE_URL}/`,
  jobTitle: "Full-stack developer",
  email: "meh.amine.gherbi@gmail.com",
  description:
    "Full-stack developer in Biskra, Algeria, working with TypeScript, Next.js, PostgreSQL and Python.",
  knowsAbout: ["TypeScript", "Next.js", "PostgreSQL", "Python"],
};
---

<Base
  title="Full-stack developer"
  description="Three case studies: an e-commerce platform, a CI/CD deployment pipeline and a document Q&A assistant."
  jsonLd={person}
  ogImage="/og/home.png"
>
  <header class="hero">
    <div class="hero-topline">
      <span class="kicker">Portfolio / 2026</span>
      <span class="kicker">Three case studies</span>
    </div>
    <h1>{positioningSentence}</h1>
    <div class="hero-foot">
      <p class="hero-note">
        Each case study describes a system, the measurement behind it, and the
        conditions where the result stops holding.
      </p>
      <p class="hero-index" aria-hidden="true">01—03</p>
    </div>
  </header>

  <section class="work" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading">Selected systems</h2>
      <p class="section-meta">Updated from committed snapshots</p>
    </div>
    <div class="project-grid">
      {
        cards.map(({ entry, manifest }) => (
          <ProjectCard
            project={entry.data}
            slug={entry.id}
            manifest={manifest}
            updatedLabel={formatUpdated(entry.data.updatedAt)}
          />
        ))
      }
    </div>
  </section>

  <section class="work thesis-note" aria-labelledby="thesis-heading">
    <div class="section-head">
      <h2 id="thesis-heading">Master's thesis</h2>
      <p class="section-meta">Text only</p>
    </div>
    <p class="thesis-line">
      <a href="/projects/thesis/"
        >Enhancing the Integrity of Algeria's Social Security System:
        Addressing Fraudulent Activities through Blockchain Technology</a
      >
    </p>
    <p class="thesis-summary">
      A blockchain platform built to strengthen the integrity of Algeria's
      social security system and counter fraud across three organisations. The
      backend runs on Hyperledger Fabric and the frontend is built with Next.js.
    </p>
  </section>

  <section class="method" aria-labelledby="method-heading">
    <div class="method-inner">
      <p class="kicker">Method</p>
      <h2 id="method-heading">Claims first, evidence second.</h2>
      <p>
        Every case begins with a sentence that can fail. The page then shows the
        measurement that supports it, the source snapshot behind that
        measurement, and the limits that keep the result honest.
      </p>
      <a href="#main">Back to the index</a>
    </div>
  </section>
</Base>
