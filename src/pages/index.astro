---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { readProjectManifest } from "../lib/manifest";
import { SITE_URL } from "../lib/site";

const positioningSentence =
  "I build full-stack web systems for teams that need to prove their software works.";

const coreStack = ["TypeScript", "Next.js", "PostgreSQL", "Python"];

const entries = await getCollection("projects");
entries.sort((a, b) => a.data.order - b.data.order);

const cards = await Promise.all(
  entries.map(async (entry) => {
    const manifest = await readProjectManifest(entry.id);

    return { entry, manifest };
  }),
);

const updatedFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

function formatUpdated(isoDate: string): string {
  return updatedFormatter.format(new Date(`${isoDate}T00:00:00.000Z`));
}

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mohamed L'Amine Gherbi",
  url: `${SITE_URL}/`,
  jobTitle: "Full-stack developer",
  email: "meh.amine.gherbi@gmail.com",
  description:
    "Full-stack developer in Biskra, Algeria, working with TypeScript, Next.js, PostgreSQL and Python.",
  knowsAbout: coreStack,
};
---

<Base
  title="Full-stack developer"
  description="Three case studies: an e-commerce platform, a CI/CD deployment pipeline and a document Q&A assistant."
  jsonLd={person}
  ogImage="/og/home.png"
>
  <header class="hero">
    <h1>{positioningSentence}</h1>
    <p class="hero-stack">{coreStack.join(", ")}</p>
  </header>

  <section id="work" class="work" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading">Selected work</h2>
      <p class="section-meta">Three case studies</p>
    </div>
    <div class="project-grid">
      {
        cards.map(({ entry, manifest }) => (
          <ProjectCard
            project={entry.data}
            slug={entry.id}
            manifest={manifest}
            updatedLabel={formatUpdated(entry.data.updatedAt)}
          />
        ))
      }
    </div>
  </section>

  <section class="work thesis-note" aria-labelledby="thesis-heading">
    <div class="section-head">
      <h2 id="thesis-heading">Master's thesis</h2>
      <p class="section-meta">Text only</p>
    </div>
    <p class="thesis-line">
      <a href="/projects/thesis/"
        >Enhancing the Integrity of Algeria's Social Security System:
        Addressing Fraudulent Activities through Blockchain Technology</a
      >
    </p>
    <p class="thesis-summary">
      A blockchain platform built to strengthen the integrity of Algeria's
      social security system and counter fraud across three organisations. The
      backend runs on Hyperledger Fabric and the frontend is built with Next.js.
    </p>
  </section>
</Base>
