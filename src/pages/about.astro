---
import Base from "../layouts/Base.astro";
import resume from "../data/resume.json";
---

<Base
  title="About"
  description={`${resume.name}, ${resume.role} in ${resume.location}. Freelance work, education, skills and languages.`}
  ogImage="/og/home.png"
>
  <article class="prose-page">
    <header class="page-header">
      <p class="kicker">About</p>
      <h1>{resume.name}</h1>
      <p class="resume-role">{resume.role} / {resume.location}</p>
    </header>

    <div class="prose-body">
      <p>{resume.summary}</p>

      <section class="resume-section" aria-labelledby="about-freelance">
        <h2 id="about-freelance">Freelance work</h2>
        <p class="freelance-years">Selected engagements, 2025-2026.</p>
        <div class="freelance-list">
          {
            resume.freelance.map((entry) => (
              <article class="freelance-entry">
                <h3>{entry.sector}</h3>
                <p>{entry.problem}</p>
                <p class="freelance-stack">{entry.stack}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="resume-section" aria-labelledby="about-education">
        <h2 id="about-education">Education</h2>
        <ul class="resume-education">
          {
            resume.education.map((entry) => (
              <li>
                <strong>{entry.credential}</strong>, {entry.institution},{" "}
                <span class="resume-years">{entry.years}</span>.
              </li>
            ))
          }
        </ul>
      </section>

      <section class="resume-section" aria-labelledby="about-skills">
        <h2 id="about-skills">Skills</h2>
        <ul class="resume-skills">
          {resume.aboutSkills.map((skill) => <li>{skill}</li>)}
        </ul>
      </section>

      <section class="resume-section" aria-labelledby="about-languages">
        <h2 id="about-languages">Languages</h2>
        <ul class="resume-skills">
          {resume.languages.map((language) => <li>{language}</li>)}
        </ul>
      </section>

      <p>
        Email <a href="mailto:meh.amine.gherbi@gmail.com">meh.amine.gherbi@gmail.com</a>.
        The full CV is on the <a href="/resume/">resume page</a>.
      </p>
    </div>
  </article>
</Base>
