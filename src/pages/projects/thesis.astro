---
import Base from "../../layouts/Base.astro";

const thesisTitle =
  "Enhancing the Integrity of Algeria's Social Security System: Addressing Fraudulent Activities through Blockchain Technology";
---

<Base
  title="Master's thesis"
  description="Master's thesis on a blockchain platform for the integrity of Algeria's social security system."
  ogImage="/og/home.png"
>
  <article class="prose-page thesis-page">
    <header class="page-header">
      <p class="kicker">Master's thesis / University Mohamed Khider Biskra / 2023-2025</p>
      <h1>{thesisTitle}</h1>
      <p class="resume-role">Software Engineering and Distributed Systems (GLSD)</p>
    </header>

    <div class="prose-body">
      <p>
        A blockchain platform built to strengthen the integrity of Algeria's
        social security system and counter fraud across three organisations.
        The backend runs on Hyperledger Fabric and the frontend is built with
        Next.js.
      </p>
      <p>
        The thesis belongs to the Master's degree in Software Engineering and
        Distributed Systems at University Mohamed Khider Biskra, 2023-2025.
      </p>
      <p>
        This page is text only. It does not carry a repository card or a demo
        link.
      </p>
      <p>
        The <a href="/about/">about page</a> carries the short CV, and the
        <a href="/resume/">resume</a> has the full record.
      </p>
      <p class="case-return"><a href="/">Back to the case index</a></p>
    </div>
  </article>
</Base>
