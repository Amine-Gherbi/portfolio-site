---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { readProjectManifest } from "../../lib/manifest";
import { assertCaseStudy, SECTION_ORDER } from "../../lib/case-study";
import { SITE_URL } from "../../lib/site";

export async function getStaticPaths() {
  const entries = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  const total = entries.length;

  return entries
    .filter((entry) => entry.data.kind === "case-study")
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry, total },
    }));
}

const { entry, total } = Astro.props;
if (entry.data.kind !== "case-study") {
  throw new Error(`Expected a case study at ${entry.id}`);
}
const study = entry.data;
assertCaseStudy(study, entry.id);

const manifest = await readProjectManifest(entry.id);
const screenshots = study.screenshots.map((screenshot, index) => {
  const shot = manifest?.shots[index + 1];
  return { ...screenshot, shot };
});

const number = String(study.order).padStart(2, "0");
const totalLabel = String(total).padStart(2, "0");

/**
 * Keep a rendered paragraph inside four lines at 1280 px. The article measure
 * is 720 px at 17 px, about 85 characters per line; group sentences up to 300
 * characters and start a new paragraph before the budget is exceeded.
 */
function paragraphs(text: string): string[] {
  const sentences = text.split(/(?<=\.)\s+(?=[A-Z(])/);
  const groups: string[] = [];
  let current = "";
  for (const sentence of sentences) {
    const candidate = current ? `${current} ${sentence}` : sentence;
    if (current && candidate.length > 300) {
      groups.push(current);
      current = sentence;
    } else {
      current = candidate;
    }
  }
  if (current) groups.push(current);
  return groups;
}

// Metrics come from the committed manifest, never from prose. Test counts are
// shown separately: invariant 4 forbids them as metrics.
const proof = manifest?.proof ?? null;
const measured = proof?.measured ?? [];
const isTestCount = (entry: { label: string; value: string }) =>
  /\b(tests?|assertions?)\b/i.test(`${entry.label} ${entry.value}`);
const metrics = measured.filter((entry) => !isTestCount(entry));
const checks = measured.filter(isTestCount);
const proofHref = (artifact: string) =>
  `/assets/${entry.id}/proof/${artifact}`;

const creativeWork = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: study.title,
  headline: study.claim,
  abstract: study.oneLiner,
  url: `${SITE_URL}/projects/${entry.id}/`,
  author: {
    "@type": "Person",
    name: "Mohamed L'Amine Gherbi",
    url: `${SITE_URL}/`,
  },
  keywords: study.stack.join(", "),
};
---

<Base
  title={study.title}
  description={study.oneLiner}
  jsonLd={creativeWork}
  ogImage={`/og/${entry.id}.png`}
>
  <article class="case-study">
    <header id="claim" class="case-header">
      <div class="case-topline">
        <a class="case-back" href="/">Case index</a>
        <span class="case-title">{study.title} / {number} of {totalLabel}</span>
      </div>
      <p class="kicker">Claim</p>
      <h1>{study.claim}</h1>
      <p class="case-oneliner"><em>{study.oneLiner}</em></p>
      <div class="case-meta">
        <p class="stack">({study.stack.join(", ")})</p>
      </div>
    </header>

    <nav class="section-nav" aria-label="Case study sections">
      <ol>
        {
          SECTION_ORDER.map((section, index) => (
            <li>
              <a href={`#${section.id}`}>
                <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                {section.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <section id="what-it-is" data-section="what-it-is" class="case-section">
      <p class="kicker">01 / What it is</p>
      <h2>What it is</h2>
      {paragraphs(study.what).map((paragraph) => <p>{paragraph}</p>)}
      <div class="screenshot-grid">
        {
          screenshots.map(({ caption, shot }) =>
            shot ? (
              <figure class="screenshot">
                <img
                  src={`/assets/${entry.id}/${shot.file}`}
                  srcset={`/assets/${entry.id}/${shot.file} ${shot.width}w`}
                  sizes="(min-width: 960px) 33vw, 100vw"
                  width={shot.width}
                  height={shot.height}
                  alt={shot.alt}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{caption}</figcaption>
              </figure>
            ) : (
              <figure class="screenshot screenshot-missing">
                <div class="screenshot-placeholder">Snapshot not yet published</div>
                <figcaption>{caption}</figcaption>
              </figure>
            ),
          )
        }
      </div>
    </section>

    <section id="hard-part" data-section="hard-part" class="case-section">
      <p class="kicker">02 / The hard part</p>
      <h2>The hard part</h2>
      {paragraphs(study.hardPart).map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section id="decision" data-section="decision" class="case-section">
      <p class="kicker">03 / The decision</p>
      <h2>The decision</h2>
      <div class="decision-list">
        <article class="decision">
          <p class="decision-index" aria-hidden="true">D1</p>
          <h3>{study.decision.title}</h3>
          <p>
            <span class="decision-label">Decision</span>
            {study.decision.choice}
          </p>
          <p>
            <span class="decision-label">Rejected alternative</span>
            {study.decision.rejected}
          </p>
          <p>
            <span class="decision-label">Cost</span>
            {study.decision.cost}
          </p>
          <p>
            <span class="decision-label">Evidence</span>
            {study.decision.evidence}
          </p>
        </article>
      </div>
    </section>

    <section id="what-broke" data-section="what-broke" class="case-section">
      <p class="kicker">04 / The failure it refuses</p>
      <h2>The failure it refuses</h2>
      {
        study.failures.map((failure) => (
          <article class="failure">
            <p class="failure-meta">Pathological case</p>
            <p>{failure.summary}</p>
            <p>
              <span class="decision-label">Mechanism</span>
              {failure.mechanism}
            </p>
          </article>
        ))
      }
    </section>

    <section id="measured" data-section="measured" class="case-section">
      <p class="kicker">05 / Measured</p>
      <h2>Measured</h2>
      {paragraphs(study.measured).map((paragraph) => <p>{paragraph}</p>)}

      <div class="metric-scroll">
        <table class="metric-table">
          <caption>Measured results and the method behind each value.</caption>
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col">Value</th>
              <th scope="col">Method</th>
              <th scope="col">Artifact</th>
            </tr>
          </thead>
          <tbody>
            {
              metrics.length > 0 ? (
                metrics.map((metric) => (
                  <tr>
                    <th scope="row">{metric.label}</th>
                    <td class="metric-value">{metric.value}</td>
                    <td>{metric.method}</td>
                    <td>
                      <a href={proofHref(metric.artifact)}>
                        <code>{metric.artifact}</code>
                      </a>
                    </td>
                  </tr>
                ))
              ) : (
                <tr>
                  <th scope="row">Committed measurement</th>
                  <td class="metric-value">pending snapshot</td>
                  <td>The committed snapshot for this project is pending.</td>
                  <td><code>pending</code></td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>

      {
        checks.length > 0 && (
          <div class="metric-checks">
            <h3>Gate checks (test counts, not metrics)</h3>
            <ul>
              {checks.map((check) => (
                <li>
                  <strong>{check.label}:</strong> {check.value}. {check.method}{" "}
                  <a href={proofHref(check.artifact)}>
                    <code>{check.artifact}</code>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        proof && (
          <div class="metric-invariants">
            <h3>Invariants and their tests</h3>
            <ul>
              {proof.invariants.map((invariant) => (
                <li>
                  {invariant.claim}{" "}
                  <a href={proofHref(invariant.test)}>
                    <code>{invariant.test}</code>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="metric-invariants">
        <h3>Artifacts</h3>
        <ul class="case-links">
          {
            study.links.map((link) => (
              <li>
                <a href={link.href} rel="noreferrer">{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="case-return"><a href="/">Back to the case index</a></p>
    </section>
  </article>
</Base>
