---
import Base from "../layouts/Base.astro";
import resume from "../data/resume.json";
---

<Base
  title="Resume"
  description={`${resume.name}, ${resume.role} in ${resume.location}. Education, experience, skills and languages.`}
  ogImage="/og/home.png"
>
  <article class="prose-page resume-page">
    <header class="page-header resume-header">
      <p class="kicker">Resume / updated {resume.generatedAt}</p>
      <h1>{resume.name}</h1>
      <p class="resume-role">{resume.role} / {resume.location}</p>
      <p class="resume-contact">
        {
          resume.contact.map((entry) => (
            <a href={entry.href}>{entry.value}</a>
          ))
        }
      </p>
      <p class="resume-download">
        <a href="/resume.pdf" download>Download the PDF</a>
      </p>
    </header>

    <div class="prose-body">
      <section class="resume-section" aria-labelledby="resume-summary">
        <h2 id="resume-summary">Summary</h2>
        <p>{resume.summary}</p>
      </section>

      <section class="resume-section" aria-labelledby="resume-experience">
        <h2 id="resume-experience">Experience</h2>
        {
          resume.experience.map((entry) => (
            <article class="resume-system">
              <h3>{entry.role}</h3>
              <p class="resume-meta">{entry.organisation} / {entry.location}</p>
              <p class="resume-meta">{entry.period}</p>
            </article>
          ))
        }
      </section>

      <section class="resume-section" aria-labelledby="resume-education">
        <h2 id="resume-education">Education</h2>
        <ul class="resume-education">
          {
            resume.education.map((entry) => (
              <li>
                <strong>{entry.credential}</strong>, {entry.institution},{" "}
                <span class="resume-years">{entry.years}</span>.
              </li>
            ))
          }
        </ul>
      </section>

      <section class="resume-section" aria-labelledby="resume-projects">
        <h2 id="resume-projects">Projects</h2>
        {
          resume.projects.map((project) => (
            <article class="resume-system">
              <h3>
                <a href={`/projects/${project.slug}/`}>{project.title}</a>
              </h3>
              <p>{project.line}</p>
            </article>
          ))
        }
      </section>

      <section class="resume-section" aria-labelledby="resume-thesis">
        <h2 id="resume-thesis">Master's thesis</h2>
        <p>
          <a href={resume.thesis.href}>{resume.thesis.title}</a>
        </p>
        <p>{resume.thesis.summary}</p>
      </section>

      <section class="resume-section" aria-labelledby="resume-skills">
        <h2 id="resume-skills">Skills</h2>
        <ul class="resume-skills">
          {resume.skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </section>

      <section class="resume-section" aria-labelledby="resume-languages">
        <h2 id="resume-languages">Languages</h2>
        <ul class="resume-skills">
          {resume.languages.map((language) => <li>{language}</li>)}
        </ul>
      </section>

      <p class="resume-source">
        The <a href="/resume.pdf" download>PDF</a> is generated from
        <code>src/data/resume.json</code> by <code>scripts/build-resume-pdf.mjs</code>
        during <code>npm run build</code>.
      </p>
    </div>
  </article>
</Base>
