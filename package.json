{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:assets": "node scripts/check-assets.mjs",
    "check:content": "node scripts/check-content.mjs",
    "fixtures": "node scripts/fixture-images.mjs",
